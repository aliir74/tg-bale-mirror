# Telegram (get api_id/api_hash from https://my.telegram.org — required in both modes)
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=tg-bale-mirror

# Listener mode (recommended): bot mode.
# Create a bot via @BotFather, add it as ADMIN of the source channel
# (otherwise it won't receive channel_post updates), paste the token here.
TG_BOT_TOKEN=

# Listener mode (legacy): userbot.
# Use only if you can't add a bot as admin of the source channel
# (e.g. you're mirroring someone else's channel where you're just a member).
# For VPS / headless: generate once with `make session` and paste here.
# Leave both TG_BOT_TOKEN and TG_SESSION_STRING unset for interactive login + .session file.
TG_SESSION_STRING=

# Source channel: numeric ID (preferred, e.g. -1001234567890) or @username
TG_SOURCE_CHANNEL=-1001234567890

# Bale (bot must be admin of the target channel)
BALE_BOT_TOKEN=123456:your_bale_bot_token
BALE_CHANNEL_ID=@your_bale_channel_or_numeric_id

# Optional
TEMP_MEDIA_DIR=./tmp
LOG_LEVEL=INFO
